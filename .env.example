# Example Environment Variables
# Copy this file to .env and fill in your actual values

# Project Configuration
PROJECT_NAME=AI Content Creator
ENVIRONMENT=development

# Backend API Keys (required)
OPENAI_API_KEY=your_openai_api_key_here
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_content_creator?retryWrites=true&w=majority
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters

# Google OAuth (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server Configuration
PORT=8000
FLASK_ENV=development
