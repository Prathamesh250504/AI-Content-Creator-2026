# Example Frontend Environment Variables
# Copy this file to .env.local for local development

# API Configuration
# For local development with backend proxy
REACT_APP_API_URL=/api

# For development with remote backend
# REACT_APP_API_URL=http://localhost:8000/api

# For mobile testing on local network
# REACT_APP_BACKEND_HOST=192.168.1.5
# REACT_APP_BACKEND_PORT=8000

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# App Configuration
REACT_APP_ENV=development
REACT_APP_NAME=AI Content Creator
